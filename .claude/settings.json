{
  "$comment": "Repo-scoped Claude Code permissions. A hosted (cloud) session reads only this file and CLAUDE.md; deny rules win in every permission mode. These encode the CLAUDE.md rules that a session must not be able to break: never push main, never force-push, never create or push a tag (a v* tag publishes the container image), never merge, never stage the whole tree.",
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main:*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push *:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push * refs/tags/*)",
      "Bash(git push * v*)",
      "Bash(git tag *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(gh repo *)",
      "Bash(gh ruleset*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method DELETE*)"
    ],
    "allow": [
      "Bash(python3 cli/*)",
      "Bash(python3 -c *)",
      "Bash(bash scripts/pre-push-scan.sh*)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout -b claude/*)",
      "Bash(git switch -c claude/*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(diff *)"
    ]
  }
}
